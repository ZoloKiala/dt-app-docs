{
	admin off
	auto_https off
}

# Railway provides $PORT; fall back to 80 for local runs.
:{$PORT:80} {
	root * /srv
	encode gzip zstd
	file_server
	try_files {path} {path}/ {path}/index.html

	# Friendly 404 -> the site's own 404 page if present, else latest/.
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /latest/404.html
		file_server
	}
}
